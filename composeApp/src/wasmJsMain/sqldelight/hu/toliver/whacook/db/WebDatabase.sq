import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE settings (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

getAllSettings:
SELECT * FROM settings;

getSetting:
SELECT * FROM settings WHERE key = :key;

getSettingFlow:
SELECT value FROM settings WHERE key = :key;

insertSetting:
INSERT OR REPLACE INTO settings(key, value)
VALUES ?;

deleteSetting:
DELETE FROM settings WHERE key = :key;

CREATE TABLE recipes (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    ingredients TEXT NOT NULL,
    steps TEXT NOT NULL,
    tools TEXT NOT NULL,
    serving TEXT NOT NULL,
    favourite INTEGER AS Boolean NOT NULL,
    category TEXT NOT NULL,
    timeToMake TEXT NOT NULL,
    generationTime TEXT NOT NULL,
    rating INTEGER AS Int NOT NULL
);

getAllRecipes:
SELECT * FROM recipes;

getRecipeById:
SELECT * FROM recipes WHERE id = :id;

insertRecipe:
INSERT OR REPLACE INTO recipes(id, name, ingredients, steps, tools, serving, favourite, category, timeToMake, generationTime, rating)
VALUES ?;

deleteRecipeById:
DELETE FROM recipes WHERE id = :id;

deleteAll:
DELETE FROM recipes;